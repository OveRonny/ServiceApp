@using System.Text.Json
@using Microsoft.JSInterop
@using ServiceApp.UI.Features.FoodStorage.Models
@inject IJSRuntime JS
@inject ServiceApp.UI.Features.FoodStorage.Services.IFoodStorageService FoodStorageService

<section class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <div class="text-uppercase text-muted small">Egne lister</div>
                <h2 class="h4 mb-0">Handlelister</h2>
            </div>
            <span class="badge text-bg-primary">@selectedIds.Count valgt</span>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-8">
                <input class="form-control" placeholder="Navn på handlelisten" @bind="listName" />
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-success w-100" disabled="@(selectedIds.Count == 0)"
                        @onclick="SaveListAsync">Lagre handleliste</button>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-2 mb-3">
            @foreach (var item in AvailableItems.OrderBy(x => x.Quantity > 0).ThenBy(x => x.Product.Name))
            {
                <div class="col">
                    <label class="d-flex align-items-center gap-2 border rounded p-2 h-100">
                        <input type="checkbox" class="form-check-input m-0"
                               checked="@selectedIds.Contains(item.Id)"
                               @onchange="args => SetSelected(item.Id, args.Value is true)" />
                        <span class="flex-grow-1">
                            <strong>@item.Product.Name</strong>
                            <small class="d-block text-muted">@item.Quantity @item.Unit · @(item.Category ?? "Uten kategori")</small>
                        </span>
                        <span class="badge @(item.Quantity <= 0 ? "text-bg-danger" : "text-bg-secondary")">
                            @(item.Quantity <= 0 ? "Tomt" : "På lager")
                        </span>
                    </label>
                </div>
            }
        </div>

        @if (lists.Count > 0)
        {
            <div class="row row-cols-1 row-cols-lg-2 g-3">
                @foreach (var list in lists.Where(x => x.Items.Count == 0 || x.Items.Any(item => !item.IsPurchased))
                    .OrderByDescending(x => x.CreatedAt))
                {
                    <div class="col">
                        <article class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="flex-grow-1 me-2">
                                    <InputText class="form-control fw-semibold" @bind-Value="list.Name" @bind-Value:after="PersistAsync" />
                                    <div class="small text-muted mt-1">@list.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteListAsync(list.Id)">Slett</button>
                            </div>
                            <label class="form-label small">Butikk</label>
                            <select class="form-select mb-3" @bind="list.FoodStoreId" @bind:after="PersistAsync">
                                <option value="">Velg butikk</option>
                                @foreach (var store in stores) { <option value="@store.Id">@store.Name</option> }
                            </select>
                            @foreach (var item in list.Items)
                            {
                                <div class="border-top py-3">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <strong>@item.ProductName</strong>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItemAsync(list, item)">Fjern vare</button>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label small">Kjøpt antall</label>
                                            <div class="input-group"><InputNumber class="form-control" min="0.001" @bind-Value="item.Quantity" @bind-Value:after="PersistAsync" /><span class="input-group-text">@item.Unit</span></div>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Pris per @item.Unit</label>
                                            <div class="input-group"><InputNumber class="form-control" min="0.01" @bind-Value="item.UnitPrice" @bind-Value:after="PersistAsync" /><span class="input-group-text">kr</span></div>
                                            @if (item.UnitPrice.HasValue) { <small class="text-muted">Tidligere pris er foreslått</small> }
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Best før</label>
                                            <InputDate class="form-control" @bind-Value="item.BestBeforeDate" @bind-Value:after="PersistAsync" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Fryst dato</label>
                                            <InputDate class="form-control" @bind-Value="item.FrozenDate" @bind-Value:after="PersistAsync" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Plassering</label>
                                            <select class="form-select" @bind="item.Location" @bind:after="PersistAsync">
                                                @if (!locations.Any(x => x.Name == item.Location))
                                                {
                                                    <option value="@item.Location">@item.Location</option>
                                                }
                                                @foreach (var location in locations)
                                                {
                                                    <option value="@location.Name">@location.Name</option>
                                                }
                                            </select>
                                            <small class="text-muted">Husket fra matlageret</small>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(list.ErrorMessage))
                            {
                                <div class="alert alert-danger py-2">@list.ErrorMessage</div>
                            }
                            <button type="button" class="btn btn-success w-100 mt-2" disabled="@list.IsSaving"
                                    @onclick="() => RegisterPurchaseAsync(list)">
                                @(list.IsSaving ? "Registrerer…" : "Registrer handel og legg på lager")
                            </button>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private const string StorageKey = "food-storage-custom-shopping-lists";
    [Parameter, EditorRequired] public IReadOnlyList<FoodStockItemModel> Stock { get; set; } = [];
    private readonly HashSet<int> selectedIds = [];
    private List<SavedShoppingList> lists = [];
    private readonly List<FoodStockItemModel> scannedItems = [];
    private IEnumerable<FoodStockItemModel> AvailableItems => Stock.Concat(scannedItems)
        .GroupBy(x => x.Product.Id).Select(x => x.First());
    private string listName = string.Empty;
    private IReadOnlyList<FoodStorageLocationModel> locations = [];
    private bool loaded;
    private IReadOnlyList<FoodStoreModel> stores = [];

    [Parameter] public EventCallback OnStockUpdated { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (!string.IsNullOrWhiteSpace(json))
            lists = JsonSerializer.Deserialize<List<SavedShoppingList>>(json) ?? [];
        stores = await FoodStorageService.GetStoresAsync();
        locations = await FoodStorageService.GetLocationsAsync();
        foreach (var savedItem in lists.SelectMany(x => x.Items))
        {
            var stockItem = Stock.FirstOrDefault(x => x.Id == savedItem.StockItemId);
            if (stockItem is null) continue;
            if (savedItem.ProductId == 0)
            {
                savedItem.ProductId = stockItem.Product.Id;
                savedItem.CategoryId = stockItem.CategoryId;
                savedItem.Unit = stockItem.Unit;
                savedItem.Location = stockItem.Location;
                savedItem.MinimumQuantity = stockItem.MinimumQuantity;
            }
            savedItem.Quantity = savedItem.Quantity <= 0 ? 1 : savedItem.Quantity;
            savedItem.UnitPrice ??= savedItem.TotalPrice.HasValue
                ? savedItem.TotalPrice / savedItem.Quantity : stockItem.LatestUnitPrice;
        }
        loaded = true;
        StateHasChanged();
    }

    private void SetSelected(int id, bool selected)
    {
        if (selected) selectedIds.Add(id);
        else selectedIds.Remove(id);
    }

    private async Task SaveListAsync()
    {
        var items = AvailableItems.Where(x => selectedIds.Contains(x.Id))
            .Select(x => new SavedShoppingListItem
            {
                StockItemId = x.Id, ProductId = x.Product.Id, ProductName = x.Product.Name,
                CategoryId = x.CategoryId, Unit = x.Unit, Location = x.Location,
                MinimumQuantity = x.MinimumQuantity, Quantity = 1, UnitPrice = x.LatestUnitPrice
            })
            .ToList();
        if (items.Count == 0) return;
        lists.Add(new SavedShoppingList
        {
            Id = Guid.NewGuid(),
            Name = string.IsNullOrWhiteSpace(listName) ? $"Handleliste {DateTime.Today:dd.MM.yyyy}" : listName.Trim(),
            CreatedAt = DateTimeOffset.Now,
            Items = items
        });
        selectedIds.Clear();
        listName = string.Empty;
        await PersistAsync();
    }

    public void AddScannedProduct(FoodProductModel product)
    {
        var existing = AvailableItems.FirstOrDefault(x => x.Product.Id == product.Id);
        if (existing is not null)
        {
            selectedIds.Add(existing.Id);
            StateHasChanged();
            return;
        }

        var location = locations.FirstOrDefault()?.Name ?? "Matlager";
        var scanned = new FoodStockItemModel(
            -product.Id,
            product,
            0,
            "stk",
            location,
            null,
            null,
            null,
            null,
            null,
            null,
            null,
            0,
            null,
            []);
        scannedItems.Add(scanned);
        selectedIds.Add(scanned.Id);
        StateHasChanged();
    }

    private async Task DeleteListAsync(Guid id)
    {
        lists.RemoveAll(x => x.Id == id);
        await PersistAsync();
    }

    private async Task RemoveItemAsync(SavedShoppingList list, SavedShoppingListItem item)
    {
        list.Items.Remove(item);
        if (list.Items.Count == 0) lists.Remove(list);
        await PersistAsync();
    }

    private async Task PersistAsync()
    {
        if (loaded)
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(lists));
    }
    private async Task RegisterPurchaseAsync(SavedShoppingList list)
    {
        list.ErrorMessage = null;
        if (list.Items.Any(x => x.Quantity <= 0))
        {
            list.ErrorMessage = "Antall må være større enn null.";
            return;
        }
        if (list.Items.Any(x => x.UnitPrice.HasValue) && !list.FoodStoreId.HasValue)
        {
            list.ErrorMessage = "Velg butikk når pris er registrert.";
            return;
        }
        if (list.Items.Any(x => x.ProductId <= 0))
        {
            list.ErrorMessage = "En eldre vare mangler produktkobling. Lag en ny handleliste med varen.";
            return;
        }

        list.IsSaving = true;
        try
        {
            foreach (var item in list.Items.Where(x => !x.IsPurchased))
            {
                await FoodStorageService.AddStockAsync(new AddFoodStockModel
                {
                    FoodProductId = item.ProductId, FoodCategoryId = item.CategoryId,
                    Quantity = item.Quantity, MinimumQuantity = item.MinimumQuantity,
                    Unit = item.Unit, Location = item.Location, BestBeforeDate = item.BestBeforeDate, FrozenDate = item.FrozenDate,
                    PurchasedDate = DateOnly.FromDateTime(DateTime.Today),
                    FoodStoreId = item.UnitPrice.HasValue ? list.FoodStoreId : null,
                    TotalPrice = item.UnitPrice * item.Quantity
                });
                item.IsPurchased = true;
                await PersistAsync();
            }
            await PersistAsync();
            await OnStockUpdated.InvokeAsync();
        }
        catch (Exception ex) { list.ErrorMessage = ex.Message; }
        finally { list.IsSaving = false; }
    }

    public sealed class SavedShoppingList
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public DateTimeOffset CreatedAt { get; set; }
        public int? FoodStoreId { get; set; }
        [System.Text.Json.Serialization.JsonIgnore] public bool IsSaving { get; set; }
        [System.Text.Json.Serialization.JsonIgnore] public string? ErrorMessage { get; set; }
        public List<SavedShoppingListItem> Items { get; set; } = [];
    }

    public sealed class SavedShoppingListItem
    {
        public int StockItemId { get; set; }
        public int ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public int? CategoryId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal? TotalPrice { get; set; }
        public decimal? MinimumQuantity { get; set; }
        public string Unit { get; set; } = "stk";
        public decimal? UnitPrice { get; set; }
        public DateOnly? BestBeforeDate { get; set; }
        public DateOnly? FrozenDate { get; set; }
        public string Location { get; set; } = "Matlager";
        public bool IsPurchased { get; set; }
    }
}
