@using ServiceApp.UI.Features.FoodStorage.Models
@using ServiceApp.UI.Features.FoodStorage.Services
@inject IFoodStorageService FoodStorageService

<button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="ToggleAsync">Priser</button>
@if (show)
{
    <div class="price-history-backdrop" @onclick="Close">
        <section class="price-history-dialog" role="dialog" aria-modal="true" aria-labelledby="price-history-title"
                 @onclick:stopPropagation="true">
            <header class="price-history-header">
                <div>
                    <div class="text-uppercase text-muted small">Matlager</div>
                    <h2 id="price-history-title" class="h4 mb-0">Prishistorikk</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Lukk" @onclick="Close"></button>
            </header>
            <div class="price-history-body">
            @if (history.Count == 0)
            {
                <div class="empty-price-history">
                    <span class="empty-price-icon">🏷️</span>
                    <strong>Ingen priser registrert</strong>
                    <span class="text-muted">Pris vises her etter at varen er lagt inn med butikk og kjøpspris.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0 price-history-table">
                        <thead><tr><th>Dato</th><th>Butikk</th><th class="text-end">Totalpris</th><th class="text-end">Pris per enhet</th></tr></thead>
                        <tbody>
                        @foreach (var price in history)
                        {
                            <tr>
                                <td>@price.PurchasedDate.ToString("dd.MM.yyyy")</td>
                                <td><strong>@price.StoreName</strong><div class="text-muted small">@price.Quantity.ToString("N2") @price.Unit</div></td>
                                <td class="text-end price-total">@price.TotalPrice.ToString("N2") kr</td>
                                <td class="text-end"><span class="unit-price">@price.UnitPrice.ToString("N2") kr/@price.Unit</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            </div>
        </section>
        </div>
}

@code {
    [Parameter] public int ProductId { get; set; }
    private IReadOnlyList<FoodPriceHistoryModel> history = [];
    private bool show;
    private async Task ToggleAsync()
    {
        show = !show;
        if (show) history = await FoodStorageService.GetPriceHistoryAsync(ProductId);
    }
    private void Close() => show = false;
}
