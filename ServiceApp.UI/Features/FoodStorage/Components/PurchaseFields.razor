@using ServiceApp.UI.Features.FoodStorage.Models
@using ServiceApp.UI.Features.FoodStorage.Services
@inject IFoodStorageService FoodStorageService

@if (OpeningInventory)
{
    <div class="col-12"><div class="alert alert-info mb-0">Pris, leverandør og kjøpsdato kan stå tomt. Varen blir likevel tatt med i beholdningen.</div></div>
}
<div class="col-md-3">
    <label class="form-label">Kjøpsdato</label>
    <InputDate class="form-control" @bind-Value="Model.PurchasedDate" />
</div>
<div class="col-md-3">
    <label class="form-label">Butikk eller leverandør</label>
    <InputSelect class="form-select" @bind-Value="Model.FoodStoreId">
        <option value="">Ikke kjent</option>
        @foreach (var store in stores)
        {
            <option value="@store.Id">@store.Name</option>
        }
    </InputSelect>
</div>
<div class="col-md-2">
    <label class="form-label">Pris per @Model.Unit (valgfritt)</label>
    <div class="input-group"><InputNumber class="form-control" @bind-Value="Model.UnitPrice" /><span class="input-group-text">kr</span></div>
    @if (Model.UnitPrice is decimal unitPrice)
    {
        <div class="form-text">Totalpris for @Model.Quantity.ToString("N2") @Model.Unit: @((unitPrice * Model.Quantity).ToString("N2")) kr</div>
    }
</div>
<div class="col-12">
    <div class="form-check mb-2">
        <input id="direct-farmer" class="form-check-input" type="checkbox" @bind="directFromFarmer" />
        <label class="form-check-label" for="direct-farmer">Handlet direkte fra bonde</label>
    </div>
    @if (directFromFarmer)
    {
        <div class="input-group input-group-sm mb-2" style="max-width:420px">
            <input class="form-control" placeholder="Navn på gård eller bonde" @bind="farmerName" />
            <button type="button" class="btn btn-outline-success" @onclick="CreateFarmerAsync">Bruk leverandør</button>
        </div>
        <div class="form-text mb-2">Lagres som «Direkte fra bonde – navn» i pris- og kjøpshistorikken.</div>
    }
    <div class="input-group input-group-sm" style="max-width:420px">
        <input class="form-control" placeholder="Legg til ny butikk" @bind="newStoreName" />
        <button type="button" class="btn btn-outline-secondary" @onclick="CreateStoreAsync">Ny butikk</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AddFoodStockModel Model { get; set; } = null!;
    [Parameter] public bool OpeningInventory { get; set; }
    private IReadOnlyList<FoodStoreModel> stores = [];
    private string newStoreName = string.Empty;
    private string farmerName = string.Empty;
    private bool directFromFarmer;

    protected override async Task OnInitializedAsync() => stores = await FoodStorageService.GetStoresAsync();

    private async Task CreateStoreAsync()
    {
        if (string.IsNullOrWhiteSpace(newStoreName)) return;
        var store = await FoodStorageService.CreateStoreAsync(newStoreName);
        stores = await FoodStorageService.GetStoresAsync();
        Model.FoodStoreId = store.Id;
        newStoreName = string.Empty;
    }

    private async Task CreateFarmerAsync()
    {
        if (string.IsNullOrWhiteSpace(farmerName)) return;
        var store = await FoodStorageService.CreateStoreAsync($"Direkte fra bonde – {farmerName.Trim()}");
        stores = await FoodStorageService.GetStoresAsync();
        Model.FoodStoreId = store.Id;
        farmerName = string.Empty;
        directFromFarmer = false;
    }
}
