@using ServiceApp.UI.Features.FoodStorage.Models
@using ServiceApp.UI.Features.FoodStorage.Services
@inject IFoodStorageService FoodStorageService

<section class="shopping-list-card mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="text-uppercase text-muted small">Automatisk forslag</div>
            <h2 class="h4 mb-0">🛒 Anbefalt handleliste</h2>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="LoadAsync">Oppdater</button>
    </div>

    @if (items.Count == 0)
    {
        <div class="shopping-list-empty">Alle varer er over minimumsbeholdningen.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-2">
            @foreach (var item in items)
            {
                <div class="col">
                    <div class="shopping-list-item">
                        <div>
                            <strong>@item.ProductName</strong>
                            <div class="small text-muted">@item.Category · @item.Location</div>
                            <div class="small">På lager: @item.CurrentQuantity @item.Unit · Minimum: @item.MinimumQuantity @item.Unit</div>
                        </div>
                        <span class="buy-quantity">Kjøp @item.RecommendedQuantity @item.Unit</span>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<FoodShoppingListItemModel> items = [];
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => items = await FoodStorageService.GetShoppingListAsync();
}
