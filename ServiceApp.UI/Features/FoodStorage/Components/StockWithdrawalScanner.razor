@using ServiceApp.UI.Features.FoodStorage.Models
@using ServiceApp.UI.Features.FoodStorage.Services
@inject IFoodStorageService FoodStorageService

<section class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div><div class="text-uppercase text-muted small">Uttak</div><h2 class="h4 mb-1">Skann vare ut av lager</h2><p class="text-muted mb-0">Skann varen og velg antallet som tas ut.</p></div>
            <div class="d-flex flex-wrap gap-2">
                <BarcodeCameraScanner OnDetected="HandleBarcodeAsync" />
                <button type="button" class="btn btn-outline-primary" @onclick="ToggleManualPicker">
                    @(showManualPicker ? "Lukk varelisten" : "Kan ikke skanne varen")
                </button>
            </div>
        </div>
        @if (showManualPicker)
        {
            <div class="border rounded p-3 mt-3">
                <label class="form-label" for="manual-withdraw-item">Velg vare fra lageret</label>
                <InputSelect id="manual-withdraw-item" TValue="int?" class="form-select" @bind-Value="manualStockItemId" @bind-Value:after="SelectManualItem">
                    <option value="">Velg vare</option>
                    @foreach (var item in AvailableStockItems)
                    {
                        <option value="@item.Id">@item.Product.Name – @item.Quantity.ToString("N2") @item.Unit</option>
                    }
                </InputSelect>
            </div>
        }
        @if (selectedItem is not null)
        {
            <div class="border rounded p-3 mt-3">
                <strong>@selectedItem.Product.Name</strong>
                <div class="small text-muted mb-3">På lager: @selectedItem.Quantity @selectedItem.Unit</div>
                @if (ActiveBatches.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label" for="withdraw-batch">Velg varen som skal tas ut</label>
                        <InputSelect id="withdraw-batch" class="form-select" @bind-Value="selectedBatchId">
                            <option value="">Velg dato og parti</option>
                            @foreach (var batch in ActiveBatches)
                            {
                                <option value="@batch.Id">@BatchLabel(batch)</option>
                            }
                        </InputSelect>
                        <div class="form-text">Velg registreringen med riktig best før-, fryse- eller kjøpsdato.</div>
                    </div>
                }
                <div class="input-group">
                    <InputNumber class="form-control" min="0.001" max="@AvailableQuantity" @bind-Value="quantity" />
                    <span class="input-group-text">@selectedItem.Unit</span>
                    <button type="button" class="btn btn-warning" disabled="@isSaving" @onclick="WithdrawAsync">Ta ut</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0">@message</div> }
    </div>
</section>

<section class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Uttakshistorikk</h2><button class="btn btn-sm btn-outline-primary" @onclick="LoadHistoryAsync">Oppdater</button></div>
        @if (history.Count == 0) { <div class="text-muted">Ingen uttak registrert.</div> }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Dato</th><th>Vare</th><th>Tatt ut</th><th>Igjen</th></tr></thead><tbody>
            @foreach (var entry in history)
            {
                <tr><td>@entry.RemovedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td>@entry.ProductName</td><td>@entry.Quantity @entry.Unit</td><td>@entry.RemainingQuantity @entry.Unit</td></tr>
            }
            </tbody></table></div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FoodStockItemModel> Stock { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    private FoodStockItemModel? selectedItem;
    private bool showManualPicker;
    private int? manualStockItemId;
    private IReadOnlyList<FoodStockWithdrawalModel> history = [];
    private decimal quantity = 1;
    private int? selectedBatchId;
    private IReadOnlyList<FoodStockBatchModel> ActiveBatches => selectedItem?.Batches.Where(x => x.Quantity > 0).ToList() ?? [];
    private IEnumerable<FoodStockItemModel> AvailableStockItems => Stock
        .Where(x => x.Quantity > 0)
        .OrderBy(x => x.Product.Name);
    private FoodStockBatchModel? SelectedBatch => ActiveBatches.FirstOrDefault(x => x.Id == selectedBatchId);
    private decimal AvailableQuantity => SelectedBatch?.Quantity ?? (ActiveBatches.Count == 0 ? selectedItem?.Quantity ?? 0 : 0);
    private bool isSaving;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    private void ToggleManualPicker()
    {
        showManualPicker = !showManualPicker;
        if (!showManualPicker) manualStockItemId = null;
    }

    private void SelectManualItem()
    {
        selectedItem = Stock.FirstOrDefault(x => x.Id == manualStockItemId && x.Quantity > 0);
        if (selectedItem is null)
        {
            selectedBatchId = null;
            message = null;
            return;
        }

        PrepareSelectedItem();
    }

    private async Task HandleBarcodeAsync(string barcode)
    {
        isError = false; message = null;
        var product = await FoodStorageService.LookupBarcodeAsync(new string(barcode.Where(char.IsAsciiDigit).ToArray()));
        selectedItem = product is null ? null : Stock.FirstOrDefault(x => x.Product.Id == product.Id);
        if (selectedItem is null || selectedItem.Quantity <= 0) { isError = true; message = "Varen finnes ikke på lager."; selectedItem = null; return; }
        PrepareSelectedItem();
    }

    private void PrepareSelectedItem()
    {
        quantity = 1;
        selectedBatchId = null;
        isError = false;
        message = ActiveBatches.Count > 0
            ? $"Velg hvilken registrering av {selectedItem!.Product.Name} som skal tas ut."
            : $"{selectedItem!.Product.Name} er klar for uttak.";
    }
    private async Task WithdrawAsync()
    {
        if (selectedItem is null || (ActiveBatches.Count > 0 && !selectedBatchId.HasValue))
        {
            isError = true; message = "Velg hvilket parti varen skal tas fra."; return;
        }
        if (quantity <= 0 || quantity > AvailableQuantity)
        {
            isError = true; message = "Antallet må være mellom null og tilgjengelig antall i partiet."; return;
        }
        isSaving = true;
        try
        {
            await FoodStorageService.WithdrawStockAsync(selectedItem.Product.Id, quantity, selectedBatchId);
            message = $"{quantity} {selectedItem.Unit} {selectedItem.Product.Name} er tatt ut.";
            isError = false; selectedItem = null; manualStockItemId = null;
            await LoadHistoryAsync(); await OnSaved.InvokeAsync();
        }
        catch (Exception ex) { isError = true; message = ex.Message; }
        finally { isSaving = false; }
    }

    private static string BatchLabel(FoodStockBatchModel batch)
    {
        var dates = new[]
        {
            batch.BestBeforeDate is { } bestBefore ? $"Best før {bestBefore:dd.MM.yyyy}" : null,
            batch.FrozenDate is { } frozen ? $"Fryst {frozen:dd.MM.yyyy}" : null,
            batch.PurchasedDate is { } purchased ? $"Kjøpt {purchased:dd.MM.yyyy}" : null
        }.Where(x => x is not null);
        var details = string.Join(" · ", dates);
        return $"{batch.Quantity:N2} – {(string.IsNullOrWhiteSpace(details) ? "Dato ikke satt" : details)}";
    }
    private async Task LoadHistoryAsync() => history = await FoodStorageService.GetStockWithdrawalsAsync();
}
