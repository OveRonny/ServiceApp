@page "/food-shopping-list"
@attribute [Authorize]
@using ServiceApp.UI.Features.FoodStorage.Components
@using ServiceApp.UI.Features.FoodStorage.Models
@using ServiceApp.UI.Features.FoodStorage.Services
@inject IFoodStorageService FoodStorageService

<PageTitle>Handleliste</PageTitle>

<main class="container-lg py-3 shopping-page">
    <header class="mb-3">
        <div class="text-uppercase text-muted small">Matlager</div>
        <h1 class="h2 mb-1">🛒 Handleliste</h1>
        <p class="text-muted mb-0">Anbefalte varer og dine egne aktive handlelister.</p>
    </header>

    <nav class="d-flex gap-2 mb-4">
        <a class="btn btn-primary" href="/food-shopping-list">Aktive lister</a>
        <a class="btn btn-outline-primary" href="/food-shopping-list-history">Gamle handlelister</a>
    </nav>

    <section class="card mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h5 mb-1">Skann vare til handlelisten</h2>
                <p class="text-muted mb-0">Skann strekkoden, så blir varen valgt automatisk.</p>
            </div>
            <BarcodeCameraScanner OnDetected="HandleScannedBarcodeAsync" />
        </div>
        @if (!string.IsNullOrWhiteSpace(scanMessage))
        {
            <div class="card-footer">@scanMessage</div>
        }
    </section>

    <RecommendedShoppingList @key="shoppingListVersion" />
    @if (isLoading)
    {
        <div class="text-muted">Laster varer…</div>
    }
    else
    {
        <CustomShoppingLists @ref="customShoppingLists" Stock="stock" OnStockUpdated="ReloadAfterPurchaseAsync" />
    }
</main>

@code {
    private IReadOnlyList<FoodStockItemModel> stock = [];
    private bool isLoading = true;

    private int shoppingListVersion;
    private CustomShoppingLists? customShoppingLists;
    private string? scanMessage;
    protected override async Task OnInitializedAsync()
    {
        stock = await FoodStorageService.GetStockAsync();
        isLoading = false;
    }
    private async Task ReloadAfterPurchaseAsync()
    {
        stock = await FoodStorageService.GetStockAsync();
        shoppingListVersion++;
    }

    private async Task HandleScannedBarcodeAsync(string detectedBarcode)
    {
        scanMessage = "Slår opp varen…";
        try
        {
            var barcode = new string(detectedBarcode.Where(char.IsAsciiDigit).ToArray());
            var product = await FoodStorageService.LookupBarcodeAsync(barcode);
            if (product is null)
            {
                scanMessage = "Varen ble ikke funnet. Opprett den først i Matlager.";
                return;
            }

            customShoppingLists?.AddScannedProduct(product);
            scanMessage = $"{product.Name} er valgt til handlelisten.";
        }
        catch (Exception ex)
        {
            scanMessage = $"Kunne ikke legge til varen: {ex.Message}";
        }
    }
}
