@page "/food-storage"
@attribute [Authorize]
@using ServiceApp.UI.Features.FoodStorage.Models
@using ServiceApp.UI.Features.FoodStorage.Services
@inject IFoodStorageService FoodStorageService
@using ServiceApp.UI.Features.FoodStorage.Components

<PageTitle>Matlager</PageTitle>

<div class="container-xxl page-section mt-3 food-storage-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">🥫 Matlager</h1>
            <p class="text-muted mb-0">Skann en strekkode eller registrer en matvare manuelt.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="form-check form-switch mb-3">
        <InputCheckbox id="opening-inventory" class="form-check-input" @bind-Value="isOpeningInventory" @bind-Value:after="OpeningInventoryChanged" />
        <label class="form-check-label" for="opening-inventory"><strong>Registrer startlager</strong></label>
        <div class="form-text">Bruk ved første lageropptelling. Pris, leverandør og kjøpsdato er valgfritt.</div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <label class="form-label" for="barcode">Strekkode</label>
            <div class="input-group">
                <input id="barcode" class="form-control" inputmode="numeric" autocomplete="off"
                       placeholder="Skann eller skriv EAN-koden" @bind="barcode" @bind:event="oninput" />
                <button class="btn btn-primary" disabled="@isBusy" @onclick="LookupBarcodeAsync">Slå opp</button>
            </div>
                <BarcodeCameraScanner OnDetected="HandleBarcodeDetectedAsync" />
            <div class="form-text">Produktdata hentes fra Open Food Facts og lagres lokalt etter første treff.</div>
        </div>
    </div>

    @if (selectedProduct is not null)
    {
        <div class="card mb-4 border-success">
            <div class="card-body">
                <div class="d-flex gap-3 align-items-start">
                    @if (!string.IsNullOrWhiteSpace(selectedProduct.ImageUrl))
                    {
                        <img src="@selectedProduct.ImageUrl" alt="" style="width:72px;height:72px;object-fit:contain" />
                    }
                    <div class="flex-grow-1">
                        <h2 class="h5">@selectedProduct.Name</h2>
                        <div class="text-muted">@selectedProduct.Brand @selectedProduct.QuantityLabel</div>
                        <div class="small">Kilde: @selectedProduct.Source</div>
                    </div>
                </div>

                <EditForm Model="stockForm" OnValidSubmit="AddStockAsync" FormName="add-food-stock" class="row g-3 mt-2">
                    <DataAnnotationsValidator />
                    <div class="col-6 col-md-2"><label class="form-label">Antall</label><InputNumber class="form-control" @bind-Value="stockForm.Quantity" /></div>
                    <div class="col-6 col-md-2"><label class="form-label">Minimum</label><InputNumber class="form-control" @bind-Value="stockForm.MinimumQuantity" /></div>
                    <div class="col-6 col-md-2"><label class="form-label">Enhet</label><InputText class="form-control" @bind-Value="stockForm.Unit" /></div>
                    <StorageLocationFields Model="stockForm" />
                    <FoodCategoryFields Model="stockForm" />
                    <div class="col-md-3"><label class="form-label">Best før</label><InputDate class="form-control" @bind-Value="stockForm.BestBeforeDate" /><div class="form-text">Varer med ulike datoer legges inn som separate antallsgrupper.</div></div>
                    <div class="col-md-3"><label class="form-label">Fryst dato</label><InputDate class="form-control" @bind-Value="stockForm.FrozenDate" /><div class="form-text">Frysevarer bør brukes innen 2 år.</div></div>
                    <PurchaseFields Model="stockForm" OpeningInventory="isOpeningInventory" />
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-success w-100" disabled="@isBusy">@(isOpeningInventory ? "Legg i startlager" : "Legg på lager")</button></div>
                    <ValidationSummary />
                </EditForm>
            </div>
        </div>
    }
    else if (showManualForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5">Produktet ble ikke funnet</h2>
                <EditForm Model="manualProduct" OnValidSubmit="CreateManualProductAsync" FormName="manual-food-product" class="row g-3">
                    <DataAnnotationsValidator />
                    <div class="col-md-5"><label class="form-label">Produktnavn</label><InputText class="form-control" @bind-Value="manualProduct.Name" /></div>
                    <div class="col-md-3"><label class="form-label">Merke</label><InputText class="form-control" @bind-Value="manualProduct.Brand" /></div>
                    <div class="col-md-2"><label class="form-label">Pakning</label><InputText class="form-control" @bind-Value="manualProduct.QuantityLabel" /></div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Opprett</button></div>
                    <ValidationSummary />
                </EditForm>
            </div>
        </div>
    }


    <StockWithdrawalScanner Stock="stock" OnSaved="RefreshAfterQuantityAsync" />
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div>
            <h2 class="h4 mb-1">Beholdning</h2>
            <div class="text-muted">@stock.Count varer · @PricedItemCount med registrert pris · @MissingPriceCount mangler pris</div>
        </div>
        <div class="text-end">
            <div class="text-muted small text-uppercase">Total lagerverdi</div>
            <div class="h3 mb-0 text-success">@TotalStockValue.ToString("N2") kr</div>
            @if (MissingPriceCount > 0) { <div class="small text-warning">+ @MissingPriceCount varer uten pris</div> }
        </div>
    </div>
    <div class="btn-group mb-3" role="group" aria-label="Velg lagerstatus">
        <button type="button" class="btn @(showOutOfStock ? "btn-outline-primary" : "btn-primary")"
                @onclick="() => showOutOfStock = false">På lager (@InStockCount)</button>
        <button type="button" class="btn @(showOutOfStock ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => showOutOfStock = true">Tomt (@OutOfStockCount)</button>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <input class="form-control" placeholder="Søk etter produkt, merke, kategori eller plassering" @bind="searchText" @bind:event="oninput" />
        </div>
        <div class="col-12">
            <button type="button" class="btn @(showMissingPrices ? "btn-warning" : "btn-outline-warning")"
                    @onclick="() => showMissingPrices = !showMissingPrices">Mangler pris (@MissingPriceCount)</button>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="sortOrder">
                <option value="name">Sorter: Navn</option><option value="category">Kategori</option><option value="expiry">Dato</option>
                <option value="quantity-desc">Mengde, høyest først</option><option value="value-desc">Verdi, høyest først</option>
            </select>
        </div>
    </div>
    @if (isLoading)
    {
        <p><em>Laster…</em></p>
    }
    else if (!FilteredAndSortedStock.Any())
    {
        <div class="alert alert-info">Matlageret er tomt.</div>
    }
    else
    {
        <div class="food-stock-mobile d-md-none">
            @foreach (var item in FilteredAndSortedStock)
            {
                <article class="food-stock-card @(IsExpiringSoon(item) ? "is-expiring" : null)">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div class="min-w-0">
                            <h3 class="h5 mb-1 text-break">@item.Product.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(item.Product.Brand))
                            {
                                <div class="text-muted small text-break">@item.Product.Brand</div>
                            }
                        </div>
                        <span class="badge rounded-pill text-bg-secondary">@(item.Category ?? "Uten kategori")</span>
                    </div>

                    <div class="food-stock-grid mb-3">
                        <div><span>Plassering</span><strong>@item.Location</strong></div>
                        <div><span>Best før</span><strong>@(item.BestBeforeDate?.ToString("dd.MM.yyyy") ?? "Ikke satt")</strong></div>
                        <div><span>Fryst dato</span><strong>@(item.FrozenDate?.ToString("dd.MM.yyyy") ?? "Ikke satt")</strong></div>
                        <div><span>Siste enhetspris</span><strong>@(item.LatestUnitPrice is decimal mobilePrice ? $"{mobilePrice:N2} kr/{item.Unit}" : "Pris mangler")</strong></div>
                        <div><span>Lagerverdi</span><strong>@(item.LatestUnitPrice.HasValue ? $"{item.EstimatedValue:N2} kr" : "Ikke beregnet")</strong></div>
                    </div>

                    <div class="mobile-editor mb-2">
                        <label>Beholdning</label>
                        <StockQuantityEditor StockItemId="item.Id" Value="item.Quantity" Unit="item.Unit" OnSaved="RefreshAfterQuantityAsync" />
                    </div>
                    <div class="mobile-editor mb-3">
                        <label>Minimumsbeholdning</label>
                        <MinimumQuantityEditor StockItemId="item.Id" Value="item.MinimumQuantity" OnSaved="RefreshAfterMinimumAsync" />
                    </div>

                    <div class="food-stock-actions">
                        <button class="btn btn-sm btn-primary" @onclick="() => PrepareAddQuantity(item)">Legg til</button>
                        <StockItemEditor Item="item" OnSaved="RefreshAfterQuantityAsync" />
                        @if (!item.LatestUnitPrice.HasValue && item.Quantity > 0)
                        {
                            <MissingPriceEditor StockItemId="item.Id" Quantity="item.Quantity" Unit="item.Unit" OnSaved="ReloadAsync" />
                        }
                        <PriceHistory ProductId="item.Product.Id" OnSaved="ReloadAsync" />
                        @if (item.Batches.Count > 1) { <StockBatches Item="item" /> }
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => SetEmptyAsync(item.Id)">Sett tom</button>
                    </div>
                </article>
            }
        </div>

        <div class="table-responsive d-none d-md-block">
            <table class="table align-middle">
                <thead><tr><th>Produkt</th><th>Kategori</th><th>Beholdning</th><th>Minimum</th><th>Enhetspris</th><th>Verdi</th><th>Plassering</th><th>Dato</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in FilteredAndSortedStock)
                {
                    <tr class="@(IsExpiringSoon(item) ? "table-warning" : null)">
                        <td><strong>@item.Product.Name</strong><br /><small class="text-muted">@item.Product.Brand</small></td>
                        <td>@(item.Category ?? "–")</td>
                        <td><StockQuantityEditor StockItemId="item.Id" Value="item.Quantity" Unit="item.Unit" OnSaved="RefreshAfterQuantityAsync" /></td>
                        <td><MinimumQuantityEditor StockItemId="item.Id" Value="item.MinimumQuantity" OnSaved="RefreshAfterMinimumAsync" /></td>
                        <td>@(item.LatestUnitPrice is decimal unitPrice ? $"{unitPrice:N2} kr/{item.Unit}" : "Pris mangler")</td>
                        <td>@if (item.LatestUnitPrice.HasValue) { <strong>@item.EstimatedValue.ToString("N2") kr</strong> } else { <span class="text-muted">Ikke beregnet</span> }</td><td>@item.Location</td>
                        <td><div><span class="small text-muted">Best før:</span> @(item.BestBeforeDate?.ToString("dd.MM.yyyy") ?? "–")</div><div><span class="small text-muted">Fryst:</span> @(item.FrozenDate?.ToString("dd.MM.yyyy") ?? "–")</div></td>
                        <td class="text-end position-relative">
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => PrepareAddQuantity(item)">Legg til antall</button>
                            <StockItemEditor Item="item" OnSaved="RefreshAfterQuantityAsync" />
                            @if (!item.LatestUnitPrice.HasValue && item.Quantity > 0)
                            {
                                <MissingPriceEditor StockItemId="item.Id" Quantity="item.Quantity" Unit="item.Unit" OnSaved="ReloadAsync" />
                            }
                            <PriceHistory ProductId="item.Product.Id" OnSaved="ReloadAsync" />
                        @if (item.Batches.Count > 1) { <StockBatches Item="item" /> }
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => SetEmptyAsync(item.Id)">Sett tom</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly AddFoodStockModel stockForm = new();
    private readonly ManualFoodProductModel manualProduct = new();
    private List<FoodStockItemModel> stock = [];
    private FoodProductModel? selectedProduct;
    private string searchText = string.Empty;
    private string sortOrder = "name";
    private string barcode = string.Empty;
    private string? errorMessage;
    private bool showManualForm;
    private bool isBusy;
    private bool isLoading = true;
    private bool showOutOfStock;
    private int shoppingListVersion;

    private bool showMissingPrices;
    private bool isOpeningInventory;
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task LookupBarcodeAsync()
    {
        errorMessage = null; showManualForm = false; selectedProduct = null; isBusy = true;
        try
        {
            selectedProduct = await FoodStorageService.LookupBarcodeAsync(barcode);
            if (selectedProduct is null) { showManualForm = true; manualProduct.Barcode = barcode; }
            else stockForm.FoodProductId = selectedProduct.Id;
        }
        catch (Exception ex) { errorMessage = $"Oppslaget mislyktes: {ex.Message}"; }
        finally { isBusy = false; }
    }
    private async Task HandleBarcodeDetectedAsync(string detectedBarcode)
    {
        barcode = new string(detectedBarcode.Where(char.IsAsciiDigit).ToArray());
        if (!string.IsNullOrWhiteSpace(barcode))
            await LookupBarcodeAsync();
    }


    private async Task CreateManualProductAsync()
    {
        selectedProduct = await FoodStorageService.CreateManualProductAsync(manualProduct);
        stockForm.FoodProductId = selectedProduct.Id; showManualForm = false;
    }

    private async Task AddStockAsync()
    {
        isBusy = true;
        try
        {
            await FoodStorageService.AddStockAsync(stockForm);
            selectedProduct = null;
            barcode = string.Empty;
            stockForm.FoodStoreId = null;
            stockForm.UnitPrice = null;
            stockForm.TotalPrice = null;
            shoppingListVersion++;
            await ReloadAsync();
        }
        finally { isBusy = false; }
    }
    private void PrepareAddQuantity(FoodStockItemModel item)
    {
        selectedProduct = item.Product;
        showManualForm = false;
        errorMessage = null;
        barcode = string.Empty;
        stockForm.FoodCategoryId = item.CategoryId;
        stockForm.FoodProductId = item.Product.Id;
        stockForm.Quantity = 1;
        stockForm.MinimumQuantity = item.MinimumQuantity;
        stockForm.Unit = item.Unit;
        stockForm.Location = item.Location;
        stockForm.BestBeforeDate = null;
        stockForm.FrozenDate = null;
        stockForm.PurchasedDate = DateOnly.FromDateTime(DateTime.Today);
        stockForm.FoodStoreId = item.LatestFoodStoreId;
        stockForm.UnitPrice = item.LatestUnitPrice;
        stockForm.TotalPrice = null;
        isOpeningInventory = false;
    }


    private async Task SetEmptyAsync(int id) { await FoodStorageService.DeleteStockAsync(id); shoppingListVersion++; await ReloadAsync(); }
    private async Task ReloadAsync() { isLoading = true; stock = (await FoodStorageService.GetStockAsync()).ToList(); isLoading = false; }
    private decimal TotalStockValue => stock.Sum(x => x.EstimatedValue);
    private async Task RefreshAfterMinimumAsync()
    {
        shoppingListVersion++;
        await ReloadAsync();
    }
    private async Task RefreshAfterQuantityAsync()
    {
        shoppingListVersion++;
        await ReloadAsync();
    }


    private int PricedItemCount => stock.Count(x => x.LatestUnitPrice.HasValue);
    private int InStockCount => stock.Count(x => x.Quantity > 0);
    private int OutOfStockCount => stock.Count(x => x.Quantity <= 0);

    private int MissingPriceCount => stock.Count(x => x.Quantity > 0 && !x.LatestUnitPrice.HasValue);
    private IEnumerable<FoodStockItemModel> FilteredAndSortedStock
    {
        get
        {
            var query = stock.Where(item => (showOutOfStock ? item.Quantity <= 0 : item.Quantity > 0) &&
                (!showMissingPrices || !item.LatestUnitPrice.HasValue) &&
                (string.IsNullOrWhiteSpace(searchText) ||
                item.Product.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (item.Product.Brand?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (item.Category?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                item.Location.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

            return sortOrder switch
            {
                "category" => query.OrderBy(x => x.Category).ThenBy(x => x.Product.Name),
                "expiry" => query.OrderBy(x => x.BestBeforeDate is null).ThenBy(x => x.BestBeforeDate),
                "quantity-desc" => query.OrderByDescending(x => x.Quantity),
                "value-desc" => query.OrderByDescending(x => x.EstimatedValue),
                _ => query.OrderBy(x => x.Product.Name)
            };
        }
    }
    private void OpeningInventoryChanged()
    {
        if (isOpeningInventory)
            stockForm.PurchasedDate = null;
        else if (!stockForm.PurchasedDate.HasValue)
            stockForm.PurchasedDate = DateOnly.FromDateTime(DateTime.Today);
    }
    private static bool IsExpiringSoon(FoodStockItemModel item) =>
        item.BestBeforeDate is { } date &&
        date <= DateOnly.FromDateTime(DateTime.Today.AddDays(7));
}
