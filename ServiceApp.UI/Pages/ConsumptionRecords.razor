@page "/consumptionrecords/{vehicleId:int}"
@inject IConsumptionRecordService ConsumptionRecordService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="cr-page">

    <!-- Header -->
    <div class="cr-header">
        <div>
            <h1 class="cr-title">⛽ Forbrukslogg</h1>
            @if (consumptionRecords?.Count > 0)
            {
                <p class="cr-subtitle">@consumptionRecords.First().Make @consumptionRecords.First().Model</p>
            }
        </div>
        <button class="btn-add-cr" @onclick="@(() => NavigationManager.NavigateTo($"/consumptionrecord/create/vehicle/{VehicleId}"))">
            + Legg til
        </button>
    </div>

    <!-- Summary cards -->
    <ConsumptionSummary
        TotalMilage="summary.TotalDriven"
        TotalDieselAdded="summary.TotalDieselAdded"
        TotalCost="summary.TotalCost"
        AveragePricePerLiter="summary.AveragePrice"
        AverageDieselConsumption="summary.AvgConsumption" />

    <!-- Date filter -->
    <div class="cr-filter-bar">
        <div class="cr-filter-group">
            <label class="cr-filter-label" for="startDate">Fra dato</label>
            <InputDate class="cr-filter-input" id="startDate" @bind-Value="startDate" @bind-Value:after="GetFilteredRecords" />
        </div>
        <div class="cr-filter-group">
            <label class="cr-filter-label" for="endDate">Til dato</label>
            <InputDate class="cr-filter-input" id="endDate" @bind-Value="endDate" @bind-Value:after="GetFilteredRecords" />
        </div>
    </div>

    <!-- Empty state -->
    @if (consumptionRecords is not null && consumptionRecords.Count == 0)
    {
        <div class="cr-empty">Ingen forbruksdata funnet for det valgte tidsrommet.</div>
    }

    <!-- Mobile cards -->
    @if (consumptionRecords is not null && consumptionRecords.Count > 0)
    {
        <div class="d-md-none cr-card-list">
            @foreach (var record in consumptionRecords)
            {
                <div class="cr-card">
                    <div class="cr-card-top">
                        <span class="cr-card-date">📅 @record.Date.ToShortDateString()</span>
                        <span class="cr-card-cost">@CurrencyFormatter.FormatKr(record.TotalCost)</span>
                    </div>
                    <div class="cr-card-stats">
                        <div class="cr-stat">
                            <span class="cr-stat-label">Km-stand</span>
                            <span class="cr-stat-value">@record.Mileage</span>
                        </div>
                        <div class="cr-stat">
                            <span class="cr-stat-label">Kjørte km</span>
                            <span class="cr-stat-value">@record.DrivenKm</span>
                        </div>
                        <div class="cr-stat">
                            <span class="cr-stat-label">Liter</span>
                            <span class="cr-stat-value">@record.DieselAdded</span>
                        </div>
                        <div class="cr-stat">
                            <span class="cr-stat-label">Pris/l</span>
                            <span class="cr-stat-value">@record.DieselPricePerLiter</span>
                        </div>
                        <div class="cr-stat">
                            <span class="cr-stat-label">Forbruk</span>
                            <span class="cr-stat-value">@(record.DieselConsumption is not null ? record.DieselConsumption.Value.ToString("F2") : "-")</span>
                        </div>
                    </div>
                    <div class="cr-card-actions">
                        <button class="cr-btn-edit" @onclick="@(() => NavigationManager.NavigateTo($"/consumptionrecord/{record.Id}"))">✏️ Rediger</button>
                        <button class="cr-btn-delete" @onclick="@(() => DeleteConsumption(record.Id))">🗑 Slett</button>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop table -->
        <div class="d-none d-md-block cr-table-wrap">
            <table class="cr-table">
                <thead>
                    <tr>
                        <th>Dato</th>
                        <th class="text-end">Km-stand</th>
                        <th class="text-end">Kjørte km</th>
                        <th class="text-end">Liter</th>
                        <th class="text-end d-none d-lg-table-cell">Pris/l</th>
                        <th class="text-end d-none d-lg-table-cell">Forbruk</th>
                        <th class="text-end">Sum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in consumptionRecords)
                    {
                        <tr>
                            <td>@record.Date.ToShortDateString()</td>
                            <td class="text-end">@record.Mileage</td>
                            <td class="text-end">@record.DrivenKm</td>
                            <td class="text-end">@record.DieselAdded</td>
                            <td class="text-end d-none d-lg-table-cell">@record.DieselPricePerLiter</td>
                            <td class="text-end d-none d-lg-table-cell">@(record.DieselConsumption?.ToString("F2") ?? "-")</td>
                            <td class="text-end">@CurrencyFormatter.FormatKr(record.TotalCost)</td>
                            <td class="text-nowrap text-end">
                                <button class="cr-btn-edit cr-btn-sm" @onclick="@(() => NavigationManager.NavigateTo($"/consumptionrecord/{record.Id}"))">✏️ Rediger</button>
                                <button class="cr-btn-delete cr-btn-sm" @onclick="@(() => DeleteConsumption(record.Id))">🗑 Slett</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    private List<ConsumptionRecordModel> consumptionRecords = new List<ConsumptionRecordModel>();
    private ConsumptionSummaryModel summary = new();

    [Parameter]
    public int VehicleId { get; set; }

    private DateTime? startDate = DateTime.UtcNow.AddYears(-1); // Standard: Ett år tilbake
    private DateTime? endDate = DateTime.UtcNow; // Standard: Dagens dato


 

    protected override async Task OnParametersSetAsync()
    {
        await GetFilteredRecords();
    }

    private async Task DeleteConsumption(int id)
    {
        await ConsumptionRecordService.DeleteConsumptionRecordAsync(id);        
        await GetFilteredRecords();
    }

    private async Task GetFilteredRecords()
    {
        var result = await ConsumptionRecordService.GetAllConsumptionRecordsAsync(VehicleId, startDate, endDate);
        if (result != null)
        {
            consumptionRecords = result.Records;
            summary = result.Summary;
        }
    }
}
