@page "/dashboard"
@using ServiceApp.UI.Services
@inject IHttpClientFactory HttpFactory

@if (_loading)
{
    <div class="dashboard-loading">
        <p>⏳ Laster dashbord...</p>
    </div>
}
else if (_data == null)
{
    <div class="text-danger p-4">⚠️ Kunne ikke laste dashbord. (@_errorStatus)</div>
}
else
{
    <div class="dashboard-page">
        <h1 class="dashboard-title">Dashbord</h1>

        <!-- ── STAT CARDS ──────────────────────────────────────────── -->
        <div class="stat-grid">

            <!-- Filmer -->
            <div class="stat-section">
                <div class="stat-section-header">🎬 Filmer</div>
                <div class="stat-cards">
                    <div class="stat-card">
                        <span class="stat-value">@_data.Movies.TotalWatched</span>
                        <span class="stat-label">Sett</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-value">@_data.Movies.TotalInWatchlist</span>
                        <span class="stat-label">I liste</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-value">@_data.Movies.TotalHoursWatched</span>
                        <span class="stat-label">Timer sett</span>
                    </div>
                </div>
            </div>

            <!-- TV-serier -->
            <div class="stat-section">
                <div class="stat-section-header">📺 TV-serier</div>
                <div class="stat-cards">
                    <div class="stat-card">
                        <span class="stat-value">@_data.TvSeries.TotalInWatchlist</span>
                        <span class="stat-label">I liste</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-value">@_data.TvSeries.TotalSeasonsWatched</span>
                        <span class="stat-label">Sesonger sett</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-value">@_data.TvSeries.TotalEpisodesWatched</span>
                        <span class="stat-label">Episoder sett</span>
                    </div>
                </div>
            </div>

            <!-- Kjøretøy -->
            <div class="stat-section">
                <div class="stat-section-header">🚗 Kjøretøy</div>
                <div class="stat-cards">
                    <div class="stat-card stat-card--wide">
                        <span class="stat-value">@_data.Vehicles.TotalVehicles</span>
                        <span class="stat-label">Registrerte kjøretøy</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-lower">

            <!-- ── KJØRETØY OVERSIKT ──────────────────────────────── -->
            <div class="dashboard-panel">
                <h2 class="panel-title">🚗 Kjøretøy</h2>
                @if (_data.Vehicles.Summaries.Any())
                {
                    <div class="vcard-grid">
                        @foreach (var v in _data.Vehicles.Summaries)
                        {
                            <div class="vcard">
                                <!-- Header -->
                                <div class="vcard-header">
                                    <div class="vcard-title">
                                        <span class="vcard-make-model">@v.Year @v.Make @v.Model</span>
                                    </div>
                                    <span class="vcard-plate">@v.LicensePlate</span>
                                </div>

                                <!-- Stats -->
                                <div class="vcard-stats">
                                    @if (v.LatestMileage.HasValue)
                                    {
                                        <div class="vcard-stat-row">
                                            <span class="vcard-stat-icon">🛣</span>
                                            <span class="vcard-stat-label">Kilometerstand</span>
                                            <span class="vcard-stat-value">@v.LatestMileage.Value.ToString("N0") km</span>
                                        </div>
                                    }
                                    @if (v.LastFuelDate.HasValue)
                                    {
                                        <div class="vcard-stat-row">
                                            <span class="vcard-stat-icon">⛽</span>
                                            <span class="vcard-stat-label">Siste tanking</span>
                                            <span class="vcard-stat-value">@v.LastFuelLiters?.ToString("F1") L &nbsp;<span class="vcard-stat-date">@v.LastFuelDate.Value.ToString("d. MMM yyyy")</span></span>
                                        </div>
                                    }
                                    @if (v.LastServiceDate.HasValue)
                                    {
                                        <div class="vcard-stat-row">
                                            <span class="vcard-stat-icon">🔧</span>
                                            <span class="vcard-stat-label">Siste service</span>
                                            <span class="vcard-stat-value">
                                                @if (!string.IsNullOrEmpty(v.LastServiceType))
                                                {
                                                    <span>@v.LastServiceType</span>
                                                }
                                                &nbsp;<span class="vcard-stat-date">@v.LastServiceDate.Value.ToString("d. MMM yyyy")</span>
                                                @if (v.LastServiceMileage.HasValue)
                                                {
                                                    <span class="vcard-stat-date">&nbsp;· @v.LastServiceMileage.Value.ToString("N0") km</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>

                                @if (v.InsuranceCompany is not null && v.InsuranceAnnualLimit > 0)
                                {
                                    var pct = Math.Clamp((double)(v.InsuranceUsedKm ?? 0) / v.InsuranceAnnualLimit.Value * 100, 0, 100);
                                    var barClass = pct >= 90 ? "vcard-ins-bar--danger" : pct >= 75 ? "vcard-ins-bar--warn" : "vcard-ins-bar--ok";
                                    <div class="vcard-ins">
                                        <div class="vcard-ins-header">
                                            <span class="vcard-stat-icon">🛡</span>
                                            <span class="vcard-stat-label">@v.InsuranceCompany</span>
                                            <span class="vcard-ins-km">@((v.InsuranceUsedKm ?? 0).ToString("N0")) / @v.InsuranceAnnualLimit.Value.ToString("N0") km</span>
                                        </div>
                                        <div class="vcard-ins-track">
                                            <div class="vcard-ins-bar @barClass" style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        <div class="vcard-ins-remaining">@((v.InsuranceRemainingKm ?? 0).ToString("N0")) km gjenstår</div>
                                    </div>
                                }

                                <!-- Actions -->
                                <div class="vcard-actions">
                                    <NavLink class="vcard-btn vcard-btn--fuel" href="@($"consumptionrecords/{v.Id}")">⛽ Forbruk</NavLink>
                                    <NavLink class="vcard-btn vcard-btn--service" href="@($"servicerecords/{v.Id}")">🔧 Service</NavLink>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-panel-msg">Ingen kjøretøy registrert enda.</p>
                }
            </div>

            <!-- ── NYLIG SETT ─────────────────────────────────────── -->
            @if (_data.RecentWatches.Any())
            {
                <div class="dashboard-panel">
                    <h2 class="panel-title">🕐 Nylig sett</h2>
                    <div class="recent-grid">
                        @foreach (var item in _data.RecentWatches)
                        {
                            var href = item.Type == "Movie"
                                ? $"moviedetails/{item.TmdbId}"
                                : $"tv-serie-details/{item.TmdbId}";

                            <NavLink class="recent-card" href="@href">
                                @if (!string.IsNullOrEmpty(item.PosterUrl))
                                {
                                    <img src="@item.PosterUrl" alt="@item.Title" />
                                }
                                else
                                {
                                    <div class="recent-card-no-poster">🎬</div>
                                }
                                <div class="recent-card-info">
                                    <span class="recent-title">@item.Title</span>
                                    <span class="recent-type @(item.Type == "Movie" ? "badge-movie" : "badge-tv")">
                                        @(item.Type == "Movie" ? "Film" : "Serie")
                                    </span>
                                    @if (item.WatchDate.HasValue)
                                    {
                                        <span class="recent-date">@item.WatchDate.Value.ToString("d. MMM")</span>
                                    }
                                </div>
                            </NavLink>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private DashboardViewModel? _data;
    private bool _loading = true;
    private string _errorStatus = "";

    protected override async Task OnInitializedAsync()
    {
        var http = HttpFactory.CreateClient("ApiAuthed");
        var response = await http.GetAsync("api/dashboard");
        if (response.IsSuccessStatusCode)
            _data = await response.Content.ReadFromJsonAsync<DashboardViewModel>();
        else
        {
            var body = await response.Content.ReadAsStringAsync();
            _errorStatus = $"HTTP {(int)response.StatusCode}: {body}";
        }
        _loading = false;
    }
}
