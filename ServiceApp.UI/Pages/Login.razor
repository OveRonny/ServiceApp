@page "/login"
@using ServiceApp.UI.Services
@inject IAuthService Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="auth-card">
    <h3>Logg inn</h3>

    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">E-post</label>
            <InputText class="form-control" @bind-Value="model.Email" type="email" autocomplete="email" />
        </div>
        <div class="mb-3">
            <label class="form-label">Passord</label>
            <InputText class="form-control" @bind-Value="model.Password" type="password" autocomplete="current-password" />
        </div>

        <button class="btn btn-primary w-100" type="submit" disabled="@_busy">
            @(_busy ? "Logger inn..." : "Logg inn")
        </button>
    </EditForm>

    @if (_showUnconfirmed)
    {
        <div class="alert alert-warning mt-3">
            <strong>E-post ikke bekreftet.</strong> Sjekk innboksen din etter bekreftelseslenken.
            <div class="mt-2">
                @if (_resendSuccess)
                {
                    <span class="text-success">✅ Ny e-post sendt!</span>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-warning" disabled="@_resending" @onclick="ResendConfirmation">
                        @(_resending ? "Sender..." : "Send bekreftelse på nytt")
                    </button>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger mt-3">@_error</div>
    }

    <p class="mt-3 text-center small">
        Har du ikke konto? <a href="/register">Registrer deg</a>
    </p>
</div>

@code {
    private LoginModel model = new();
    private string? _error;
    private bool _busy;
    private bool _showUnconfirmed;
    private bool _resending;
    private bool _resendSuccess;

    private async Task Submit()
    {
        _busy = true;
        _error = null;
        _showUnconfirmed = false;
        _resendSuccess = false;

        var ok = await Auth.LoginAsync(model.Email, model.Password);

        if (ok)
        {
            if (AuthStateProvider is JwtAuthenticationStateProvider jwt)
            {
                var token = await Auth.GetAccessTokenAsync();
                if (!string.IsNullOrEmpty(token))
                    jwt.NotifyUserAuthentication(token);
            }
            Nav.NavigateTo("/");
        }
        else
        {
            var reason = await Auth.GetLoginFailureReasonAsync(model.Email, model.Password);
            if (reason == "unconfirmed")
                _showUnconfirmed = true;
            else if (reason == "locked")
                _error = "Kontoen er deaktivert. Kontakt administrator.";
            else
                _error = "Feil e-post eller passord.";
        }

        _busy = false;
    }

    private async Task ResendConfirmation()
    {
        _resending = true;
        await Auth.ResendConfirmationEmailAsync(model.Email);
        _resending = false;
        _resendSuccess = true;
    }
}
