@page "/moviedetails/{TmdbId:int}"
@using ServiceApp.UI.Services.MovieServices
@using ServiceApp.UI.Models
@inject IMovieService MovieService
@inject NavigationManager Navigation

@if (selectedMovie == null && _loadError != null)
{
    <div style="color: var(--text-muted); padding: 40px 0;">⚠️ @_loadError</div>
}
else if (selectedMovie == null)
{
    <div style="color: var(--text-muted); padding: 40px 0;">⏳ Laster filmdetaljer...</div>
}
else
{
    <div class="movie-details-page">

        <!-- -- Hero -- -->
        <div class="md-hero">
            @if (!string.IsNullOrEmpty(selectedMovie.PosterUrl))
            {
                <img class="md-poster" src="@selectedMovie.PosterUrl" alt="@selectedMovie.Title" />
            }
            <div class="md-hero-info">
                <h1 class="md-title">@selectedMovie.Title @(selectedMovie.ReleaseDate?.Length >= 4 ? $"({selectedMovie.ReleaseDate[..4]})" : "")</h1>

                <div class="md-badges">
                    @if (selectedMovie.Runtime > 0)
                    {
                        <span class="md-badge">🕐 @selectedMovie.Runtime min</span>
                    }
                    @if (selectedMovie.Genres != null)
                    {
                        @foreach (var g in selectedMovie.Genres)
                        {
                            <span class="md-badge">@g</span>
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(selectedMovie.Overview))
                {
                    <p class="md-overview">@selectedMovie.Overview</p>
                }
            </div>
        </div>

        <!-- -- Handlinger -- -->
        <div class="md-section">
            <h2 class="md-section-title">🎬 Handlinger</h2>

            <div class="md-streaming-row">
                <select class="md-input"
                        value="@_selectedStreamingService"
                        @onchange="e => _selectedStreamingService = e.Value?.ToString() ?? string.Empty">
                    <option value="">-- Velg strømmetjeneste (valgfritt) --</option>
                    @foreach (var s in Enum.GetValues<StreamingService>())
                    {
                        <option value="@((int)s)">@s.DisplayName()</option>
                    }
                </select>
                @if (selectedMovie.IsInMyWatchlist || selectedMovie.IsWatched)
                {
                    <button class="md-btn md-btn--primary" @onclick="SaveStreamingService" disabled="@IsProcessing">
                        💾 Lagre
                    </button>
                }
            </div>

            @if (selectedMovie.IsInMyWatchlist || selectedMovie.IsWatched)
            {
                <div class="md-comment-row">
                    <textarea class="md-input md-textarea"
                              placeholder="Legg til en kommentar (valgfritt)..."
                              maxlength="1000"
                              @bind="_comment"
                              rows="3"></textarea>
                    <button class="md-btn md-btn--primary" @onclick="SaveComment" disabled="@IsProcessing">
                        💬 Lagre kommentar
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="md-msg">@StatusMessage</p>
            }

            @if (!selectedMovie.IsInMyWatchlist && !selectedMovie.IsWatched)
            {
                <div class="md-notice">
                    <span class="md-notice-text">Filmen er ikke i din liste ennå.</span>
                    <button class="md-btn md-btn--add"
                            disabled="@_isImporting"
                            @onclick="() => AddToWatchlist(selectedMovie.TmdbId)">
                        @(_isImporting ? "⏳ Legger til..." : "➕ Legg til i min liste")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_importMessage))
                {
                    <p class="md-msg">@_importMessage</p>
                }
            }
            else
            {
                <div class="md-toolbar">
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <span class="md-label">Dato</span>
                        <input type="date" class="md-input" @bind="SelectedDate" />
                        <button class="like-button" @onclick="ToggleLike" disabled="@IsProcessing">
                            @(selectedMovie.WatchHistory?.FirstOrDefault()?.Liked == true ? "👍" : "👎")
                        </button>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-left:auto;">
                        <input class="md-input md-input-small" type="number" min="0" max="10"
                               @bind="UserRating" placeholder="0–10" />
                        <button class="md-btn md-btn--primary" @onclick="RateMovie" disabled="@IsProcessing">
                            Lagre rating
                        </button>
                    </div>
                </div>

                <div class="md-secondary-row">
                    <button class="md-btn md-btn--watch"
                            @onclick="() => MarkAsWatched(selectedMovie.TmdbId)"
                            disabled="@IsProcessing">
                        @(selectedMovie.IsWatched ? "🔄 Se igjen" : "✅ Marker som sett")
                    </button>
                    <button class="md-btn md-btn--ghost" @onclick="GoBackToWatchedMovies">Sette filmer</button>
                    <button class="md-btn md-btn--ghost" @onclick="GoBackToUnWatchedMovies">Usette filmer</button>
                </div>
            }
        </div>

        <!-- -- Historikk -- -->
        @if (selectedMovie.WatchHistory != null && selectedMovie.WatchHistory.Any())
        {
            <div class="md-section">
                <h2 class="md-section-title">📋 Seehistorikk</h2>
                <table class="md-history-table">
                    <thead>
                        <tr>
                            <th>Dato</th>
                            <th>Likt</th>
                            <th>Rating</th>
                            <th>Kommentar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var watch in selectedMovie.WatchHistory)
                        {
                            <tr>
                                <td>@(watch.WatchDate?.ToString("d. MMM yyyy") ?? "—")</td>
                                <td>@(watch.Liked == true ? "👍" : "👎")</td>
                                <td>@(watch.Rating.HasValue ? $"{watch.Rating}/10" : "—")</td>
                                <td>@(watch.Comment ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
}




@code {
    [Parameter]
    public int TmdbId { get; set; }
    private DateTime SelectedDate { get; set; } = DateTime.Today;

    private string StatusMessage { get; set; } = string.Empty;
    private string? _importMessage;
    private bool _isImporting = false;
    private string _selectedStreamingService = "";
    private string? _comment;
    private int? UserRating { get; set; }
    private bool IsProcessing = false;


    private MovieDetailsViewModel? selectedMovie { get; set; } = null;

    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await ShowDetails(TmdbId);
    }

    private async Task ShowDetails(int tmdbId)
    {
        try
        {
            selectedMovie = await MovieService.GetMovieDetailsAsync(tmdbId);
            if (selectedMovie == null)
                _loadError = "Fant ikke filmen.";
            else
            {
                if (selectedMovie.StreamingService.HasValue)
                    _selectedStreamingService = ((int)selectedMovie.StreamingService.Value).ToString();
                _comment = selectedMovie.Comment;
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Kunne ikke laste filmdetaljer: {ex.Message}";
        }
    }

    private async Task ImportMovie(int tmdbId)
    {
        if (selectedMovie == null) return;

        _isImporting = true;
        _importMessage = null;

        try
        {
            StreamingService? service = int.TryParse(_selectedStreamingService, out var v) ? (StreamingService)v : null;
            await MovieService.AddMovieToWatchList(tmdbId, service);

            _importMessage = "Film er lagret i systemet.";
            selectedMovie.IsImported = true;
        }
        catch (Exception ex)
        {
            _importMessage = $"Import feilet: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task SaveStreamingService()
    {
        if (selectedMovie == null) return;
        IsProcessing = true;
        StreamingService? service = int.TryParse(_selectedStreamingService, out var v) ? (StreamingService)v : null;
        var ok = await MovieService.UpdateStreamingServiceAsync(selectedMovie.TmdbId, service);
        StatusMessage = ok ? "✅ Strømmetjeneste lagret!" : "⚠️ Kunne ikke lagre strømmetjeneste.";
        IsProcessing = false;
    }

    private async Task SaveComment()
    {
        if (selectedMovie == null) return;
        IsProcessing = true;
        var ok = await MovieService.UpdateWatchCommentAsync(selectedMovie.TmdbId, "movie", _comment);
        StatusMessage = ok ? "✅ Kommentar lagret!" : "⚠️ Kunne ikke lagre kommentar.";
        IsProcessing = false;
    }

    private async Task MarkAsWatched(int tmdbId)
    {
        if (selectedMovie == null) return;

        IsProcessing = true;
        StatusMessage = "Updating...";

        try
        {
            var success = await MovieService.MarkMovieAsWatchedAsync(
                tmdbId,
                markAsWatched: true,
                Date: SelectedDate
            );

            StatusMessage = success ? "Movie marked as watched!" : "Failed to mark as watched.";

            // 🔄 Reload movie details so UI updates
            await ShowDetails(tmdbId);
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ToggleLike()
    {
        if (selectedMovie == null) return;

        IsProcessing = true;
        StatusMessage = "Updating...";

        try
        {
            bool newLikeValue = !(selectedMovie.WatchHistory?.FirstOrDefault()?.Liked ?? false);

            var success = await MovieService.MarkMovieAsWatchedAsync(
                selectedMovie.TmdbId,
                markAsWatched: false,
                Liked: newLikeValue
            );

            if (success)
            {
                StatusMessage = newLikeValue ? "Movie liked!" : "Movie unliked!";
                await ShowDetails(selectedMovie.TmdbId); // 🔄 reload UI
            }
            else
            {
                StatusMessage = "Failed to update like.";
            }
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task AddToWatchlist(int tmdbId)
    {
        if (selectedMovie == null) return;

        _isImporting = true;
        _importMessage = null;

        try
        {
            await MovieService.AddMovieToWatchList(tmdbId);

            _importMessage = "✅ Lagt til i din liste!";

            // Reload to get updated watchlist status
            await ShowDetails(tmdbId);
        }
        catch (Exception ex)
        {
            _importMessage = $"⚠️ Kunne ikke legge til: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task RateMovie()
    {
        if (selectedMovie == null) return;

        if (!UserRating.HasValue || UserRating < 0 || UserRating > 10)
        {
            StatusMessage = "Rating must be between 0 and 10.";
            return;
        }

        IsProcessing = true;
        StatusMessage = "Updating...";

        var success = await MovieService.MarkMovieAsWatchedAsync(
            selectedMovie.TmdbId,
            markAsWatched: false,
            Rating: UserRating
        );

        if (success)
        {
            StatusMessage = $"Rated {UserRating}/10!";
            await ShowDetails(selectedMovie.TmdbId); // 🔄 reload UI
        }
        else
        {
            StatusMessage = "Failed to submit rating.";
        }

        IsProcessing = false;
    }

    private void GoBackToWatchedMovies()
    {
        Navigation.NavigateTo("/watched-movies");
    }

    private void GoBackToUnWatchedMovies()
    {
        Navigation.NavigateTo("/unwatched-movies");
    }

    // Strongly-typed command
    public record MarkMovieCommand(int TmdbId, DateTime? Date = null, bool? Liked = null, int? Rating = null);

    

}


