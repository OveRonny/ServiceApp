@page "/owners"
@inject IOwnerService ownerService
@inject NavigationManager navigationManager
@attribute [Authorize]

<div class="own-page">

    <div class="own-header">
        <div>
            <h1 class="own-title">👤 Eiere</h1>
            <p class="own-subtitle">@ownerModels.Count registrerte eiere</p>
        </div>
        <button class="own-btn-add" @onclick="NavigateToOwner">+ Ny eier</button>
    </div>

    @if (ownerModels.Count == 0)
    {
        <div class="own-empty">
            <div class="own-empty-icon">👤</div>
            <p>Ingen eiere registrert enda.</p>
            <button class="own-btn-add" @onclick="NavigateToOwner">+ Legg til første eier</button>
        </div>
    }
    else
    {
        <div class="own-grid">
            @foreach (var owner in ownerModels)
            {
                <div class="own-card">
                    <div class="own-card-header">
                        <span class="own-icon">👤</span>
                        <span class="own-badge">@(string.IsNullOrWhiteSpace(owner.City) ? "Eier" : owner.City)</span>
                    </div>
                    <div class="own-card-body">
                        <h2 class="own-name">@owner.FirstName @owner.LastName</h2>
                        <div class="own-meta">
                            @if (!string.IsNullOrWhiteSpace(owner.Address))
                            {
                                <span class="own-meta-item">📍 @owner.Address@(string.IsNullOrWhiteSpace(owner.PostalCode) ? "" : $", {owner.PostalCode}") @owner.City</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(owner.PhoneNumber))
                            {
                                <span class="own-meta-item">📞 @owner.PhoneNumber</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(owner.Email))
                            {
                                <span class="own-meta-item">✉️ @owner.Email</span>
                            }
                        </div>
                    </div>
                    <div class="own-card-footer">
                        <button class="own-btn-action own-btn-edit" @onclick="@(() => navigationManager.NavigateTo($"/owner/{owner.Id}"))">
                            ✏️ Rediger
                        </button>
                        <button class="own-btn-action own-btn-vehicles" @onclick="@(() => NavigateToOwnerVehicles(owner.Id))">
                            🚗 Kjøretøy
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private List<OwnerModel> ownerModels = new();

    protected override async Task OnInitializedAsync()
    {
        ownerModels = await ownerService.GetAllOwnersAsync();
    }

    private void NavigateToOwner() => navigationManager.NavigateTo("/owner");

    private void NavigateToOwnerVehicles(int ownerId)
        => navigationManager.NavigateTo($"/vehicles/owner/{ownerId}");
}
