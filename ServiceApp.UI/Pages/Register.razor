@page "/register"
@inject IAuthService AuthService

@if (_registered)
{
    <div class="auth-card">
        <div class="auth-success-icon">📧</div>
        <h3>Sjekk e-posten din!</h3>
        <p>Vi har sendt en bekreftelseslenke til <strong>@_registeredEmail</strong>.</p>
        <p class="text-muted small">Klikk lenken i e-posten for å aktivere kontoen din, og logg deretter inn.</p>
        <a class="btn btn-primary mt-2" href="/login">Gå til innlogging</a>
    </div>
}
else
{
    <div class="auth-card">
        <h3>Opprett konto</h3>

        <EditForm Model="@_model" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">E-post</label>
                <InputText class="form-control" @bind-Value="_model.Email" type="email" autocomplete="email" />
                <ValidationMessage For="() => _model.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Passord</label>
                <InputText class="form-control" @bind-Value="_model.Password" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="mb-3">
                <label class="form-label">Bekreft passord</label>
                <InputText class="form-control" @bind-Value="_model.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.ConfirmPassword" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <button class="btn btn-primary w-100" type="submit" disabled="@_submitting">
                @(_submitting ? "Oppretter konto..." : "Registrer deg")
            </button>
        </EditForm>

        <p class="mt-3 text-center small">
            Har du allerede konto? <a href="/login">Logg inn</a>
        </p>
    </div>
}

@code {
    private RegisterUserModel _model = new();
    private bool _submitting;
    private bool _registered;
    private string? _registeredEmail;
    private string? _error;

    private async Task OnSubmit()
    {
        _submitting = true;
        _error = null;

        var ok = await AuthService.RegisterAsync(_model.Email, _model.Password);

        if (ok)
        {
            _registeredEmail = _model.Email;
            _registered = true;
        }
        else
        {
            _error = "Registrering feilet. E-posten er kanskje allerede i bruk, eller passordet oppfyller ikke kravene.";
        }

        _submitting = false;
    }
}
