@page "/search-tv-series"
@using ServiceApp.UI.Services.TvServices
@inject ITvservice TvService
@inject TvSearchState State

<h3>SearchTvSeries</h3>

<input @bind="State.Query" placeholder="Search TV series..." />
<button @onclick="Search">Search</button>


@if (State.Results.Any())
{
    <div class="tv-grid">
        @foreach (var tv in State.Results)
        {
            <NavLink class="tv-card" href="@($"/tv-serie-details/{tv.TmdbId}")">
                <img src="@tv.PosterUrl" alt="@tv.Name" />
                <p>@tv.Overview</p>
                <p class="rating">⭐ @tv.Rating</p>
                
            </NavLink>
        }
    </div>
}



@code {
    private async Task Search()
    {
        State.Results = await TvService.SearchTvAsync(State.Query);
    }

    private async Task ImportTvSeries(int tmdbId)
    {
        var id = await TvService.ImportTvAsync(tmdbId);
        if (id == null)
        {
            Console.WriteLine("Failed to import TV series.");
        }
        else
        {
            Console.WriteLine($"TV series imported successfully (ID: {id})");
        }
    }
}
