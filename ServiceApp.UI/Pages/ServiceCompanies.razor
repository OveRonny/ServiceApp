@page "/servicecompanies"
@inject IServiceCompanyService ServiceCompanyService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="sco-page">

    <div class="sco-header">
        <div>
            <h1 class="sco-title">🏭 Firma</h1>
            <p class="sco-subtitle">@serviceCompanies.Count registrerte firma</p>
        </div>
        <button class="sco-btn-add" @onclick="NavigateToCreate">+ Nytt firma</button>
    </div>

    @if (serviceCompanies.Count == 0)
    {
        <div class="sco-empty">
            <div class="sco-empty-icon">🏭</div>
            <p>Ingen firma registrert enda.</p>
            <button class="sco-btn-add" @onclick="NavigateToCreate">+ Legg til første firma</button>
        </div>
    }
    else
    {
        <div class="sco-grid">
            @foreach (var company in serviceCompanies)
            {
                <div class="sco-card">
                    <div class="sco-card-header">
                        <span class="sco-icon">🏭</span>
                        <span class="sco-badge">Firma</span>
                    </div>
                    <div class="sco-card-body">
                        <h2 class="sco-name">@company.Name</h2>
                    </div>
                    <div class="sco-card-footer">
                        <button class="sco-btn-edit" @onclick="@(() => NavigationManager.NavigateTo($"/servicecompany/{company.Id}"))">
                            ✏️ Rediger
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private List<ServiceCompanyModel> serviceCompanies = new();

    protected override async Task OnInitializedAsync()
    {
        serviceCompanies = await ServiceCompanyService.GetAllServiceCompaniesAsync();
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/servicecompany");
    }
}
