@page "/servicecompany"
@page "/servicecompany/{id:int}"
@inject IServiceCompanyService ServiceCompanyService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="scy-page">

    <div class="scy-header">
        <h1 class="scy-title">@(Id > 0 ? "✏️ Rediger firma" : "➕ Nytt firma")</h1>
    </div>

    <div class="scy-form-card">
        <EditForm Model="serviceCompany" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <div class="scy-field">
                <label class="scy-label" for="name">Navn</label>
                <InputText id="name" class="scy-input" @bind-Value="serviceCompany.Name" placeholder="Firmanavn..." />
                <ValidationMessage For="@(() => serviceCompany.Name)" />
            </div>

            <div class="scy-actions">
                <button type="submit" class="scy-btn scy-btn-save">💾 Lagre</button>
                <button type="button" class="scy-btn scy-btn-cancel" @onclick="NavigateToServiceCompanies">Avbryt</button>
                @if (Id > 0)
                {
                    <button type="button" class="scy-btn scy-btn-delete" @onclick="DeleteServiceCompany">🗑 Slett</button>
                }
            </div>
        </EditForm>
    </div>

</div>

@code {
    private ServiceCompanyModel serviceCompany = new();

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Id > 0)
        {
            var company = await ServiceCompanyService.GetServiceCompanyByIdAsync(Id);
            serviceCompany = company ?? new ServiceCompanyModel();
        }
        else
        {
            serviceCompany = new ServiceCompanyModel();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (Id > 0)
            await ServiceCompanyService.UpdateServiceCompanyAsync(serviceCompany);
        else
            await ServiceCompanyService.AddServiceCompanyAsync(serviceCompany);

        NavigateToServiceCompanies();
    }

    private async Task DeleteServiceCompany()
    {
        if (Id > 0)
        {
            await ServiceCompanyService.DeleteServiceCompanyAsync(Id);
            NavigateToServiceCompanies();
        }
    }

    private void NavigateToServiceCompanies()
    {
        NavigationManager.NavigateTo("/servicecompanies");
    }
}
