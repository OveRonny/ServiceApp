@page "/servicetypes"
@inject IServiceTypeService ServiceTypeService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="stp-page">

    <div class="stp-header">
        <div>
            <h1 class="stp-title">🔧 Servicetyper</h1>
            <p class="stp-subtitle">@serviceTypes.Count registrerte servicetyper</p>
        </div>
        <button class="stp-btn-add" @onclick="NavigateToNewServiceType">+ Ny servicetype</button>
    </div>

    @if (serviceTypes.Count == 0)
    {
        <div class="stp-empty">
            <div class="stp-empty-icon">🔧</div>
            <p>Ingen servicetyper registrert enda.</p>
            <button class="stp-btn-add" @onclick="NavigateToNewServiceType">+ Legg til første servicetype</button>
        </div>
    }
    else
    {
        <div class="stp-grid">
            @foreach (var st in serviceTypes)
            {
                <div class="stp-card">
                    <div class="stp-card-header">
                        <span class="stp-icon">🔧</span>
                        <span class="stp-badge">Servicetype</span>
                    </div>
                    <div class="stp-card-body">
                        <h2 class="stp-name">@st.Name</h2>
                    </div>
                    <div class="stp-card-footer">
                        <button class="stp-btn-edit" @onclick="@(() => NavigationManager.NavigateTo($"/servicetype/{st.Id}"))">
                            ✏️ Rediger
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private List<ServiceTypeModel> serviceTypes = new();

    protected override async Task OnInitializedAsync()
    {
        serviceTypes = await ServiceTypeService.GetServiceTypesAsync();
    }

    private void NavigateToNewServiceType()
    {
        NavigationManager.NavigateTo("/servicetype");
    }
}
