@page "/suppliers"
@inject ISupplierService supplierService
@attribute [Authorize]

<div class="sup-page">

    <div class="sup-header">
        <div>
            <h1 class="sup-title">🏢 Leverandører</h1>
            <p class="sup-subtitle">@suppliers.Count registrerte leverandører</p>
        </div>
        <NavLink class="sup-btn-add" href="/supplier">+ Ny leverandør</NavLink>
    </div>

    @if (suppliers.Count == 0)
    {
        <div class="sup-empty">
            <div class="sup-empty-icon">🏢</div>
            <p>Ingen leverandører registrert enda.</p>
            <NavLink class="sup-btn-add" href="/supplier">+ Legg til første leverandør</NavLink>
        </div>
    }
    else
    {
        <div class="sup-grid">
            @foreach (var s in suppliers)
            {
                <div class="sup-card">
                    <div class="sup-card-header">
                        <span class="sup-icon">🏢</span>
                        <span class="sup-badge">@(string.IsNullOrWhiteSpace(s.City) ? "Leverandør" : s.City)</span>
                    </div>
                    <div class="sup-card-body">
                        <h2 class="sup-name">@s.Name</h2>
                        <div class="sup-meta">
                            @if (!string.IsNullOrWhiteSpace(s.Address))
                            {
                                <span class="sup-meta-item">📍 @s.Address@(string.IsNullOrWhiteSpace(s.PostalCode) ? "" : $", {s.PostalCode}") @s.City</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.ContactPhone))
                            {
                                <span class="sup-meta-item">📞 @s.ContactPhone</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.ContactEmail))
                            {
                                <span class="sup-meta-item">✉️ @s.ContactEmail</span>
                            }
                        </div>
                    </div>
                    <div class="sup-card-footer">
                        <NavLink class="sup-btn-edit" href="@($"/supplier/{s.Id}")">✏️ Rediger</NavLink>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private List<SupplierModel> suppliers = new();

    protected override async Task OnInitializedAsync()
    {
        suppliers = await supplierService.GetSuppliersAsync();
    }
}
