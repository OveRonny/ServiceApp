@page "/unwatched-movies"
@using ServiceApp.UI.Services.GenreServices
@inject IMovieService MovieService
@inject IGenreService GenreService
@attribute [Authorize]

<div class="movies-page">

    <div class="movies-header">
        <div>
            <h1 class="movies-title">🎬 Ikke sett</h1>
            <p class="movies-subtitle">@_total film@(_total == 1 ? "" : "er") i watchlisten</p>
        </div>
    </div>

    <div class="movies-filter-bar">
        <div class="movies-search-wrap">
            <span class="movies-search-icon">🔍</span>
            <input class="movies-search-input"
                   type="text"
                   placeholder="Søk etter film..."
                   value="@searchQuery"
                   @oninput="OnSearchInput" />
        </div>
        <InputSelect class="movies-genre-select" @bind-Value="selectedGenre" @bind-Value:after="OnGenreChanged">
            <option value="">Alle sjangere</option>
            @foreach (var g in AllGenres)
            {
                <option value="@g">@g</option>
            }
        </InputSelect>
        <button class="movies-clear-btn" @onclick="ApplyFilters">? Nullstill</button>
    </div>

    @if (Movies is null)
    {
        <div class="movies-loading">Laster filmer&#x2026;</div>
    }
    else if (Movies.Count == 0)
    {
        <div class="movies-empty">Ingen filmer funnet.</div>
    }
    else
    {
        <div class="movies-grid">
            @foreach (var movie in Movies)
            {
                <NavLink class="movie-card" href="@MovieDetailsUrl(movie)" aria-label="@movie.Title">
                    <div class="movie-poster-wrap">
                        <img class="movie-poster" src="@movie.PosterUrl" alt="@movie.Title" />
                        <div class="movie-poster-overlay">
                            <p class="movie-overview">@movie.Overview</p>
                        </div>
                        <span class="movie-unwatched-badge">👁 Ikke sett</span>
                    </div>
                    <div class="movie-info">
                        <h4 class="movie-title">@movie.Title</h4>
                        @if (movie.Genres?.Count > 0)
                        {
                            <span class="movie-genre-tag">@movie.Genres.First()</span>
                        }
                    </div>
                </NavLink>
            }
        </div>

        <div class="movies-pagination">
            <button class="movies-page-btn" @onclick="PreviousPage" disabled="@IsPreviousDisabled">&#x2190; Forrige</button>
            <span class="movies-page-info">Side @_currentPage av @TotalPages</span>
            <button class="movies-page-btn" @onclick="NextPage" disabled="@IsNextDisabled">Neste &#x2192;</button>
        </div>
    }

</div>

@code {
    private List<MovieFullDtoModel> Movies { get; set; } = new();
    private List<string> Genres { get; set; } = new();
    private string searchQuery = "";
    private List<string> AllGenres { get; set; } = new();
    private string selectedGenre = "";

    private int _currentPage = 1;
    private int _pageSize = 24;
    private int _total = 0;

    private CancellationTokenSource? _cts;

    private bool IsPreviousDisabled => _currentPage == 1;
    private bool IsNextDisabled => _currentPage * _pageSize >= _total;
    private int TotalPages => (int)Math.Ceiling(_total / (double)_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAllGenres();
        await LoadMovies();
    }

    private async Task LoadAllGenres()
    {
        var genre = await GenreService.GetAllGenresAsync();
        AllGenres = genre
            .Where(g => !string.IsNullOrEmpty(g.Name))
            .Select(g => g.Name!)
            .OrderBy(g => g)
            .ToList();
    }

    private async Task LoadMovies()
    {
        var result = await MovieService.GetFilteredUnWatchedMoviesAsync(
            _currentPage, _pageSize, searchQuery, selectedGenre);
        Movies = result.Items.ToList();
        _total = result.Total;
        Genres = Movies
            .SelectMany(m => m.Genres ?? new List<string>())
            .Distinct()
            .OrderBy(g => g)
            .ToList();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            await Task.Delay(500, token);
            _currentPage = 1;
            await LoadMovies();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task NextPage()
    {
        if (!IsNextDisabled) { _currentPage++; await LoadMovies(); }
    }

    private async Task PreviousPage()
    {
        if (!IsPreviousDisabled) { _currentPage--; await LoadMovies(); }
    }

    private async Task ApplyFilters()
    {
        searchQuery = ""; selectedGenre = ""; _currentPage = 1;
        await LoadMovies();
    }

    private async Task OnGenreChanged()
    {
        _currentPage = 1;
        await LoadMovies();
    }

    private static string MovieDetailsUrl(MovieFullDtoModel movie) => $"/moviedetails/{movie.TmdbId}";
}
