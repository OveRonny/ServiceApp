@page "/vehicles"
@page "/vehicles/owner/{OwnerId:int}"
@inject IVehicleService vehicleService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="vehicles-page">

    <div class="vehicles-header">
        <div>
            <h1 class="vehicles-title">Kjøretøy</h1>
            <p class="vehicles-subtitle">@vehicleModels.Count registrerte kjøretøy</p>
        </div>
        <button class="btn-add-vehicle" @onclick="CreateVehicle">
            + Nytt kjøretøy
        </button>
    </div>

    @if (vehicleModels.Count > 0)
    {
        <div class="vehicle-grid">
            @foreach (var vehicle in vehicleModels)
            {
                <div class="vehicle-card">

                    <!-- Card header -->
                    <div class="vehicle-card-header">
                        <div class="vehicle-icon">🚗</div>
                        <span class="vehicle-plate-badge">@vehicle.LicensePlate</span>
                    </div>

                    <!-- Main info -->
                    <div class="vehicle-card-body">
                        <h2 class="vehicle-name">@vehicle.Year @vehicle.Make @vehicle.Model</h2>
                        <div class="vehicle-meta">
                            @if (!string.IsNullOrWhiteSpace(vehicle.Color))
                            {
                                <span class="vehicle-meta-item">🎨 @vehicle.Color</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(vehicle.FirstName))
                            {
                                <span class="vehicle-meta-item">👤 @vehicle.FirstName</span>
                            }
                        </div>
                    </div>

                    <!-- Quick action links -->
                    <div class="vehicle-actions">
                        <a class="v-action" href="consumptionrecords/@vehicle.Id">
                            <span class="v-action-icon">⛽</span>
                            <span>Forbruk</span>
                        </a>
                        <a class="v-action" href="consumptionrecord/create/vehicle/@vehicle.Id">
                            <span class="v-action-icon">➕</span>
                            <span>Tanke</span>
                        </a>
                        <a class="v-action" href="servicerecords/@vehicle.Id">
                            <span class="v-action-icon">🔧</span>
                            <span>Service</span>
                        </a>
                        <a class="v-action" href="servicerecord/create/@vehicle.Id">
                            <span class="v-action-icon">📋</span>
                            <span>Ny service</span>
                        </a>
                        <a class="v-action" href="insurance/@vehicle.Id">
                            <span class="v-action-icon">🛡</span>
                            <span>Forsikring</span>
                        </a>
                        <a class="v-action" href="vehicleinventories/@vehicle.Id">
                            <span class="v-action-icon">🔩</span>
                            <span>Deler</span>
                        </a>
                    </div>

                    <!-- Footer -->
                    <div class="vehicle-card-footer">
                        <a class="vehicle-detail-link" href="vehicle/@vehicle.Id">Se alle detaljer →</a>
                        <span class="vehicle-added">Lagt til @vehicle.DateCreated.ToString("d. MMM yyyy")</span>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="vehicles-empty">
            <div class="vehicles-empty-icon">🚗</div>
            <p>Ingen kjøretøy registrert enda.</p>
            <button class="btn-add-vehicle" @onclick="CreateVehicle">+ Legg til første kjøretøy</button>
        </div>
    }

</div>

@code {
    private List<VehicleModel> vehicleModels = new();

    [Parameter] public int? OwnerId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        vehicleModels = OwnerId.HasValue
            ? await vehicleService.GetVehiclesByOwnerIdAsync(OwnerId.Value)
            : await vehicleService.GetAllVehiclesAsync();
    }

    private void CreateVehicle() => NavigationManager.NavigateTo("vehicle");
}
