@page "/watched-movie-details/{mediaId:int}"
@inject IMovieService MovieService

@if (movieDetails == null)
{
    <div class="wmd-loading">⏳ Laster filmdetaljer...</div>
}
else
{
    <div class="wmd-page">

        <!-- Hero -->
        <div class="wmd-hero">
            @if (!string.IsNullOrEmpty(movieDetails.PosterPath))
            {
                <img src="@movieDetails.PosterPath" alt="@movieDetails.Title" class="wmd-poster" />
            }
            <div class="wmd-hero-info">
                <h1 class="wmd-title">@movieDetails.Title</h1>
                <div class="wmd-badges">
                    @if (movieDetails.Runtime > 0)
                    {
                        <span class="wmd-badge">🕐 @movieDetails.Runtime min</span>
                    }
                    @foreach (var g in movieDetails.Genres)
                    {
                        <span class="wmd-badge">@g</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(movieDetails.Overview))
                {
                    <p class="wmd-overview">@movieDetails.Overview</p>
                }
            </div>
        </div>

        <!-- Watch history -->
        @if (movieDetails.WatchHistory?.Any() == true)
        {
            <div class="wmd-section">
                <h2 class="wmd-section-title">📋 Seehistorikk</h2>
                <div class="wmd-history-list">
                    @foreach (var h in movieDetails.WatchHistory)
                    {
                        <div class="wmd-history-row">
                            <span class="wmd-history-date">📅 @(h.WatchDate?.ToString("d. MMM yyyy") ?? "—")</span>
                            <div class="wmd-history-meta">
                                @if (h.Liked.HasValue)
                                {
                                    <span class="wmd-badge @(h.Liked.Value ? "badge--green" : "badge--red")">
                                        @(h.Liked.Value ? "👍 Likt" : "👎 Ikke likt")
                                    </span>
                                }
                                @if (h.Rating.HasValue)
                                {
                                    <span class="wmd-badge badge--yellow">⭐ @h.Rating/10</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
}

@code {
    [Parameter]
    public int mediaId { get; set; }

    private MovieDetailsViewModel? movieDetails;

    protected override async Task OnInitializedAsync()
    {
        if (mediaId > 0)
            movieDetails = await MovieService.GetMovieDetailsAsync(mediaId);
    }
}

