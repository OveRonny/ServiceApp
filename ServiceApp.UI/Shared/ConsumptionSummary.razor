@using Microsoft.AspNetCore.Components
@using System.Globalization

<div class="cs-summary">
    <div class="cs-stat">
        <span class="cs-stat-icon">🛣️</span>
        <span class="cs-stat-label">Totale km</span>
        <span class="cs-stat-value">@TotalMilage</span>
    </div>
    <div class="cs-stat">
        <span class="cs-stat-icon">🪣</span>
        <span class="cs-stat-label">Totalt liter</span>
        <span class="cs-stat-value">@TotalDieselAdded.ToString("F2") L</span>
    </div>
    <div class="cs-stat">
        <span class="cs-stat-icon">💰</span>
        <span class="cs-stat-label">Total kostnad</span>
        <span class="cs-stat-value">@CurrencyFormatter.FormatKr(TotalCost)</span>
    </div>
    <div class="cs-stat">
        <span class="cs-stat-icon">🏷️</span>
        <span class="cs-stat-label">Snitt pris/l</span>
        <span class="cs-stat-value">@(AveragePricePerLiter.HasValue ? CurrencyFormatter.FormatKr(AveragePricePerLiter.Value) : "-")</span>
    </div>
    <div class="cs-stat">
        <span class="cs-stat-icon">📊</span>
        <span class="cs-stat-label">Snitt forbruk</span>
        <span class="cs-stat-value">@(AverageDieselConsumption.HasValue ? $"{AverageDieselConsumption.Value:F2} L/km" : "-")</span>
    </div>
</div>

@code {
    [Parameter] public int TotalMilage { get; set; }
    [Parameter] public decimal TotalDieselAdded { get; set; }
    [Parameter] public decimal TotalCost { get; set; }
    [Parameter] public decimal? AveragePricePerLiter { get; set; }
    [Parameter] public decimal? AverageDieselConsumption { get; set; }
}